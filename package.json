{
  "name": "react-modal-port",
  "version": "1.0.1",
  "description": "Launch type-safe modals from any React component and render them in one place.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . && node scripts/smoke-test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:package",
    "prepublishOnly": "npm_config_dry_run=false npm run verify",
    "test:react": "node scripts/test-react-versions.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverwehn/react-modal-port.git"
  },
  "keywords": [
    "react",
    "react-component",
    "modal",
    "dialog",
    "typescript",
    "stack"
  ],
  "author": "Oliver Greuter-Wehn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oliverwehn/react-modal-port/issues"
  },
  "homepage": "https://github.com/oliverwehn/react-modal-port#readme",
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
